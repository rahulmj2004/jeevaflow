# JeevaFlow backend configuration.
# Copy to backend/.env, then run:
#     venv/bin/python -m app.security.init_secrets
# which fills in the JEEVAFLOW_* secrets below with random values.
# NEVER commit backend/.env. In production, inject these from a
# secret manager instead of a file.

# --- Environment -------------------------------------------------------
# development | demo | production (production enforces HTTPS, Secure
# cookies, stricter rate limits, disables demo mode and API docs).
JEEVAFLOW_ENV=development
JEEVAFLOW_DEMO_MODE=true

# --- Rate limits ---------------------------------------------------------
# Requests per key per window. Unset = environment default:
#   demo/development: IP 120, sender 30, user 120, patient 30 per 60 s
#   production:       IP 300, sender 20, user 600, patient 5 per 900 s
# Values must be positive; production refuses anything looser.
# JEEVAFLOW_RATE_LIMIT_PER_IP=120
# JEEVAFLOW_RATE_LIMIT_PER_SENDER=30
# JEEVAFLOW_RATE_LIMIT_PER_USER=120
# JEEVAFLOW_RATE_LIMIT_PER_PATIENT=30
# JEEVAFLOW_RATE_LIMIT_WINDOW_SECONDS=60
# Where patients open the verification / consent portal.
JEEVAFLOW_PORTAL_BASE_URL=http://localhost:5173
# JEEVAFLOW_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# JEEVAFLOW_COOKIE_SECURE=false

# --- Secrets (generated by init_secrets; 32 random bytes, base64) ------
JEEVAFLOW_KEK=
JEEVAFLOW_IDENTITY_KEY=
JEEVAFLOW_OTP_SECRET=
JEEVAFLOW_AUDIT_KEY=
JEEVAFLOW_SESSION_SECRET=

# --- Synthetic demo (generated by init_secrets) ------------------------
JEEVAFLOW_DEMO_STAFF_PASSWORD=
JEEVAFLOW_DEMO_TOTP_SEED=
JEEVAFLOW_DEMO_TWILIO_SIGNING_TOKEN=
# WhatsApp number of the synthetic demo patient (use your own test phone).
JEEVAFLOW_DEMO_PATIENT_PHONE=+91 98765 43210

# --- Twilio WhatsApp ---------------------------------------------------
# The auth token is used ONLY to verify webhook signatures.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Restricted API key for media download/deletion and notifications
# (preferred over the account auth token).
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# Public HTTPS base URL that Twilio calls (ngrok), no trailing slash.
PUBLIC_BASE_URL=

# --- Optional ------------------------------------------------------------
# JEEVAFLOW_DATABASE_URL=sqlite:///./jeevaflow.db
# JEEVAFLOW_IDENTITY_DATABASE_URL=sqlite:///./identity.db
# JEEVAFLOW_VAULT_DIR=./vault
# JEEVAFLOW_MAX_UPLOAD_BYTES=10485760
# JEEVAFLOW_MAX_PDF_PAGES=30
# JEEVAFLOW_DOCUMENT_RETENTION_DAYS=90
# JEEVAFLOW_CLAMAV_BINARY=/opt/homebrew/bin/clamdscan
